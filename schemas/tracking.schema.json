{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tracking.schema.json",
  "title": "Tracking frame",
  "description": "Positions of the ball and all players in one frame. Stored as JSON Lines: one frame per line.",
  "type": "object",
  "required": ["match_id", "frame", "t", "ball", "players"],
  "properties": {
    "match_id": { "type": "string" },
    "frame": { "type": "integer", "minimum": 0 },
    "t": { "type": "number", "minimum": 0, "description": "Seconds since kick-off." },
    "period": { "enum": [1, 2], "description": "Optional. First or second half. The simulator always writes it; the vision AI may omit it (derive it from match_info.periods)." },
    "ball": {
      "type": "array",
      "description": "[x, y, z] in meters. z is height above the grass.",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "team", "pos"],
        "properties": {
          "id": { "type": "integer" },
          "team": { "enum": ["home", "away", "referee"] },
          "pos": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
