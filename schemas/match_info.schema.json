{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "match_info.schema.json",
  "title": "Match info",
  "description": "Sent once per match. Defines teams, players and the coordinate system.",
  "type": "object",
  "required": [
    "match_id",
    "fps",
    "pitch",
    "origin",
    "home",
    "away"
  ],
  "properties": {
    "match_id": {
      "type": "string"
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "description": "Frames per second of the video and tracking data."
    },
    "pitch": {
      "type": "array",
      "description": "Pitch [length, width] in meters.",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "origin": {
      "const": "bottom-left",
      "description": "(0, 0) is the bottom-left corner. x runs along the length, y across the width."
    },
    "kickoff_direction": {
      "type": "object",
      "description": "Which goal each team attacks in the first half. Teams swap at half-time.",
      "properties": {
        "home": {
          "enum": [
            "left_to_right",
            "right_to_left"
          ]
        }
      }
    },
    "home": {
      "$ref": "#/$defs/team"
    },
    "away": {
      "$ref": "#/$defs/team"
    },
    "periods": {
      "type": "array",
      "description": "Start and end time (t, seconds) of each half. The clock is continuous: the second half starts right after the first ends, like a broadcast cutting the break. Display minute = 45:00 + (t - periods[1].start) in the second half.",
      "items": {
        "type": "object",
        "required": [
          "period",
          "start",
          "end"
        ],
        "properties": {
          "period": {
            "enum": [
              1,
              2
            ]
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "score_at_start": {
      "type": "object",
      "description": "Optional. The score when this clip starts, for a clip cut from mid-match: broadcast metadata, like the team sheet (the scoreboard graphic already shows it). Absent means 0-0 at kick-off.",
      "required": [
        "home",
        "away"
      ],
      "additionalProperties": false,
      "properties": {
        "home": {
          "type": "integer",
          "minimum": 0
        },
        "away": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "team": {
      "type": "object",
      "required": [
        "name",
        "short",
        "kit",
        "players"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "short": {
          "type": "string",
          "maxLength": 4
        },
        "kit": {
          "type": "object",
          "description": "Hex colors. The vision AI uses these to tell teams apart.",
          "required": [
            "shirt",
            "shorts"
          ],
          "properties": {
            "shirt": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "shorts": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "goalkeeper": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        "formation": {
          "type": "string",
          "examples": [
            "4-3-3",
            "4-4-2"
          ]
        },
        "style": {
          "type": "string",
          "description": "Optional. The team's playing style as simulated, e.g. possession, counter, pressing, direct or balanced. Agents may use it to explain play.",
          "examples": [
            "possession",
            "counter",
            "pressing",
            "direct",
            "balanced"
          ]
        },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "number",
              "name",
              "pos",
              "starter"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "description": "Unique across both teams. Home 1-99, away 101-199."
              },
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99
              },
              "name": {
                "type": "string"
              },
              "pos": {
                "enum": [
                  "GK",
                  "RB",
                  "CB",
                  "LB",
                  "RWB",
                  "LWB",
                  "DM",
                  "CM",
                  "AM",
                  "RM",
                  "LM",
                  "RW",
                  "LW",
                  "ST",
                  "CF"
                ]
              },
              "starter": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
