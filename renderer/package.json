{
  "name": "inside-the-game-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/serve.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "export": "node --import tsx scripts/export.ts",
    "test:browser": "node --import tsx scripts/smoke.ts",
    "predev": "node scripts/prepare.mjs",
    "prebuild": "node scripts/prepare.mjs",
    "validate:export": "node --import tsx scripts/validate-export.ts",
    "generate:calibration": "node --import tsx scripts/generate-calibration.ts",
    "test:calibration": "node --import tsx scripts/check-calibration.ts",
    "validate:calibration": "node --import tsx scripts/validate-calibration.ts",
    "test:simulator": "node --import tsx scripts/check-simulator.ts",
    "benchmark:capture": "node --import tsx scripts/benchmark-capture.ts",
    "test:presentation": "node --import tsx scripts/check-presentation.ts",
    "test:server": "node --import tsx scripts/check-server.ts",
    "benchmark:input": "node --import tsx scripts/benchmark-input.ts",
    "validate:simulator": "node --import tsx scripts/validate-simulator.ts",
    "test:browser:repeat": "node --import tsx scripts/repeat-browser.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/three": "^0.180.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
