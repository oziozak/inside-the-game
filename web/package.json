{
  "name": "inside-the-game-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:demo": "MATCH=data/demo/showcase,data/demo/test2,data/demo/test1,data/demo/hl1,data/demo/hl2,data/demo/hl3,data/demo/hl4 npm run build",
    "predev": "node scripts/prepare.mjs",
    "prebuild": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
